namespace streaky/template

from /core/collections import range

public function generate-template-function string; program parsed-template, function-name string
    validate-program; program
    return generate-template-function-valid; program, function-name

private function generate-template-function-valid string; program parsed-template, function-name string
    return generate-range; program, function-name, 'context', 0, program.tokens.length, 0, true

private class generation-imports
    lookup bool
    field bool
    text bool
    boolean bool
    empty bool
    output bool
    loop-context bool
    error bool

    mutable function observe-atom; expression string
        expression = expression.trim;
        if quoted; expression
            this.text = true
        else if expression == 'true' or expression == 'false'
            this.boolean = true
        else if expression == 'none'
            this.empty = true
        else
            this.lookup = true
            if expression.contains; '.'
                this.field = true

public function generate-template-unit string; output-namespace string, programs list of parsed-template, runtime-roots list of string
    if output-namespace == ''
        throw template-error; 'output namespace must not be empty'
    for segment in (output-namespace.split; '/')
        if not (valid-identifier; segment)
            throw template-error; 'invalid output namespace'
    imports = instance generation-imports;
    for program in programs
        validate-program; program
        check-template-name; program.name
        for token-index in (range; 0, program.tokens.length)
            token = program.tokens[token-index]
            if token.kind == 'output'
                imports.output = true
                parts = expression-parts; token.text
                imports.observe-atom; parts[0]
            else if token.kind == 'if'
                imports.observe-atom; (condition-expression; token.text)
            else if token.kind == 'for'
                imports.error = true
                imports.observe-atom; token.text
                if range-uses-context; program, token-index + 1, (loop-boundary; token)
                    imports.loop-context = true
            else if token.kind == 'widget'
                words = template-words; token.text
                if words.length == 2
                    imports.observe-atom; words[1]
                else
                    imports.empty = true
    source = 'namespace '.concat; output-namespace, '\nfrom /core/errors import throwable\nfrom /streaky/template import template-engine, template-value, check-template-depth'
    if imports.error
        source = source.concat; ', template-error'
    if imports.empty
        source = source.concat; ', empty-value'
    if imports.boolean
        source = source.concat; ', bool-value'
    if imports.loop-context
        source = source.concat; ', template-loop-context'
    if imports.text
        source = source.concat; ', text-value'
    if imports.output
        source = source.concat; ', format-template-value'
    if imports.lookup
        source = source.concat; ', template-lookup'
    if imports.field
        source = source.concat; ', template-field'
    source = source.concat; '\n\n'
    for program-index in (range; 0, programs.length)
        source = source.concat; (generate-template-function-valid; programs[program-index], ('render-template'.concat; program-index)), '\n\n'
    source = source.concat; 'public function make-template-engine template-engine;\n    engine = instance template-engine;\n'
    loader = instance template-loader;
    for root in runtime-roots
        loader.add-path; root
        source = source.concat; '    engine.add-path; ', (quoted-source; root), '\n'
    for program-index in (range; 0, programs.length)
        source = source.concat; '    engine.register-template; ', (quoted-source; programs[program-index].name), ', render-template', program-index, '\n'
    return source.concat; '    return engine\n'

private function atom-uses-context bool; expression string
    expression = expression.trim;
    return not (quoted; expression) and expression != 'true' and expression != 'false' and expression != 'none'

private function range-uses-context bool; program parsed-template, start int, finish int
    for index in (range; start, finish)
        token = program.tokens[index]
        if token.kind == 'include' or token.kind == 'for'
            return true
        if token.kind == 'output'
            parts = expression-parts; token.text
            if atom-uses-context; parts[0]
                return true
        else if token.kind == 'if'
            if atom-uses-context; (condition-expression; token.text)
                return true
        else if token.kind == 'widget'
            words = template-words; token.text
            if words.length == 2 and (atom-uses-context; words[1])
                return true
    return false

private function generate-range string; program parsed-template, function-name string, context-name string, start int, finish int, indent-level int, top-level bool
    source = ''
    indent = '    '
    indent-index int = 0
    while indent-index < indent-level
        indent = indent.concat; '    '
        indent-index = indent-index + 1
    if top-level
        source = 'function '.concat; function-name, ' string throws throwable; engine ref template-engine, context map of string, template-value, depth int\n    output string = \'\'\n    check-template-depth; depth\n'
        has-output bool = false
        for token in program.tokens
            if token.kind == 'output'
                has-output = true
        if has-output
            source = source.concat; '    autoescape = engine.autoescape-for; ', (quoted-source; program.name), '\n'
    cursor int = start
    while cursor < finish
        token = program.tokens[cursor]
        if token.kind == 'text'
            source = source.concat; indent, 'output = output.concat; ', (quoted-source; token.text), '\n'
        else if token.kind == 'output'
            parts = expression-parts; token.text
            filter = ''
            if parts.length == 2
                filter = parts[1].trim;
            source = source.concat; indent, 'output = output.concat; (format-template-value; ', (generated-value; parts[0], context-name), ', autoescape, ', (quoted-source; filter), ')\n'
        else if token.kind == 'if'
            negate = condition-negated; token.text
            condition = condition-expression; token.text
            source = source.concat; indent, 'condition', cursor, ' = ', (generated-value; condition, context-name), '\n'
            if negate
                source = source.concat; indent, 'if not (condition', cursor, '.truthy;)\n', indent, '    check-template-depth; depth + ', indent-level + 1, '\n'
            else
                source = source.concat; indent, 'if condition', cursor, '.truthy;\n', indent, '    check-template-depth; depth + ', indent-level + 1, '\n'
            boundary = token.end
            if token.alternate >= 0
                boundary = token.alternate
            source = source.concat; (generate-range; program, function-name, context-name, cursor + 1, boundary, indent-level + 1, false)
            if token.alternate >= 0
                source = source.concat; indent, 'else\n', indent, '    check-template-depth; depth + ', indent-level + 1, '\n'
                source = source.concat; (generate-range; program, function-name, context-name, token.alternate + 1, token.end, indent-level + 1, false)
            cursor = token.end
        else if token.kind == 'for'
            source = source.concat; indent, 'sequence', cursor, ' = ', (generated-value; token.text, context-name), '\n', indent, 'if sequence', cursor, '.kind != \'list\'\n', indent, '    throw template-error; \'for requires a list value\'\n', indent, 'loop-index', cursor, ' int = 0\n', indent, 'while loop-index', cursor, ' < sequence', cursor, '.items.length\n', indent, '    check-template-depth; depth + ', indent-level + 1, '\n'
            context-used = range-uses-context; program, cursor + 1, (loop-boundary; token)
            if context-used
                source = source.concat; indent, '    loop-context', cursor, ' = template-loop-context; ', context-name, ', ', (quoted-source; token.name), ', sequence', cursor, '.items[loop-index', cursor, '], loop-index', cursor, ', sequence', cursor, '.items.length\n'
                source = source.concat; (generate-range; program, function-name, ('loop-context'.concat; cursor), cursor + 1, (loop-boundary; token), indent-level + 1, false)
            else
                source = source.concat; (generate-range; program, function-name, context-name, cursor + 1, (loop-boundary; token), indent-level + 1, false)
            source = source.concat; indent, '    loop-index', cursor, ' = loop-index', cursor, ' + 1\n'
            if token.alternate >= 0
                source = source.concat; indent, 'if sequence', cursor, '.items.length == 0\n', indent, '    check-template-depth; depth + ', indent-level + 1, '\n'
                source = source.concat; (generate-range; program, function-name, context-name, token.alternate + 1, token.end, indent-level + 1, false)
            cursor = token.end
        else if token.kind == 'include'
            source = source.concat; indent, 'output = output.concat; (engine.fetch-context; ', (quoted-source; (unquote; token.text)), ', ', context-name, ', depth + ', indent-level + 1, ', \'compiled\')\n'
        else if token.kind == 'widget'
            words = template-words; token.text
            argument = '(empty-value;)'
            if words.length == 2
                argument = generated-value; words[1], context-name
            source = source.concat; indent, 'output = output.concat; (engine.render-widget; ', (quoted-source; words[0]), ', ', argument, ')\n'
        cursor = cursor + 1
    if top-level
        source = source.concat; '    return output\n'
    return source

private function loop-boundary int; token template-token
    if token.alternate >= 0
        return token.alternate
    return token.end

private function generated-value string; expression string, context-name string
    expression = expression.trim;
    if expression == 'true' or expression == 'false'
        return '(bool-value; '.concat; expression, ')'
    else if expression == 'none'
        return '(empty-value;)'
    else if (quoted; expression)
        return '(text-value; '.concat; (quoted-source; (unquote; expression)), ')'
    parts = expression.split; '.'
    code = '(template-lookup; ref '.concat; context-name, ', ', (quoted-source; parts[0]), ', ', (quoted-source; expression), ')'
    part-index int = 1
    while part-index < parts.length
        code = '(template-field; '.concat; code, ', ', (quoted-source; parts[part-index]), ', ', (quoted-source; expression), ')'
        part-index = part-index + 1
    return code

private function quoted-source string; value string
    data = value.encode; utf8
    result = '\''
    index int = 0
    span-start int = 0
    while index < data.length
        byte = data[index]
        if byte == 39 or byte == 92 or byte == 10 or byte == 13 or byte == 9
            if span-start < index
                result = result.concat; (data[(range; span-start, index)].decode; utf8)
            if byte == 39
                result = result.concat; '\\\''
            else if byte == 92
                result = result.concat; '\\\\'
            else if byte == 10
                result = result.concat; '\\n'
            else if byte == 13
                result = result.concat; '\\r'
            else if byte == 9
                result = result.concat; '\\t'
            index = index + 1
            span-start = index
        else
            index = index + 1
    if span-start < data.length
        result = result.concat; (data[(range; span-start, data.length)].decode; utf8)
    return result.concat; '\''
